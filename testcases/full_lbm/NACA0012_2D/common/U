FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

#include "../caseDef";

internalField   uniform ($U 0 0);

boundaryField
{
    Inlet
    {
        type            freestreamVelocity;
        freestreamValue $internalField;
    }

    Outlet
    {
        type            freestreamVelocity;
        freestreamValue $internalField;
    }

    "(Top|Bottom)"
    {
        type            symmetry;
    }
    
    Airfoil
    {
        type            noSlip;
    }

    Sides
    {
        type            empty;
    }
}

