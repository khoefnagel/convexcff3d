FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-9;
        relTol          0.1;
    }

    U
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-9;
        relTol          0.1;
        nSweeps         2;
    }

}

SIMPLE
{
    nNonOrthogonalCorrectors 1;  
    consistent		yes;  
    
    residualControl
    {
        p               1e-7;
        U               1e-7;
    }
    
    pRefCell		0;
    pRefValue		0;

}


relaxationFactors
{
    fields
    {
    	//p		0.3;
    }
    equations
    {
        U               0.7;
    }
}

cache
{
    grad(U);
}

